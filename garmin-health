#!/usr/bin/env python3
"""Waybar/Omarchy bar JSON for Garmin health.

Reads the running garmin-stats server first so the bar and the HUD share one
Garmin poll; falls back to hitting Garmin Connect directly if it's down.
"""
import json
import os
import sys
import time
import urllib.request

APP_DIR = os.path.expanduser("~/.config/garmin-health")
SERVER = os.environ.get(
    "GARMIN_STATS_URL",
    f"http://127.0.0.1:{os.environ.get('GARMIN_STATS_PORT', 8765)}",
)
ICON = ""


def out(payload):
    print(json.dumps(payload, ensure_ascii=False))
    sys.exit(0)


def from_server():
    try:
        with urllib.request.urlopen(SERVER + "/api/health", timeout=2) as r:
            state = json.load(r)
    except Exception:
        return None, None
    return state.get("data"), state.get("error")


def from_garmin():
    sys.path.insert(0, APP_DIR)
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    try:
        from garmin_data import fetch_stats

        return fetch_stats(), None
    except Exception as e:
        return None, str(e)


def age(ts):
    if not ts:
        return "?"
    m = (time.time() - ts) / 60
    if m < 1:
        return "just now"
    return f"{int(m)}m ago" if m < 90 else f"{m / 60:.1f}h ago"


def stress_band(v):
    return "rest" if v <= 25 else "low" if v <= 50 else "medium" if v <= 75 else "high"


def main() -> None:
    d, err = from_server()
    if d is None:
        d, err = from_garmin()
    if not d:
        out({"text": f"{ICON} —", "tooltip": f"Garmin: {err or 'no data'}", "class": "error"})

    hr = d.get("heart_rate")
    lines = []
    if hr:
        lines.append(f"Heart rate: {hr} bpm ({age(d.get('hr_ts'))})")
    if d.get("resting_hr"):
        lines.append(f"Resting: {d['resting_hr']} bpm")
    if d.get("hr_min") and d.get("hr_max"):
        lines.append(f"Range today: {d['hr_min']}–{d['hr_max']} bpm")
    if d.get("body_battery") is not None:
        lines.append(f"Body battery: {d['body_battery']}")
    if d.get("stress") is not None:
        lines.append(f"Stress: {d['stress']} ({stress_band(d['stress'])})")
    if d.get("steps") is not None:
        goal = d.get("step_goal")
        lines.append(f"Steps: {d['steps']:,}" + (f" / {goal:,}" if goal else ""))
    if err:
        lines.append(f"⚠ last refresh failed: {err}")

    out({
        "text": f"{ICON} {hr if hr else '—'}",
        "tooltip": "\n".join(lines) if lines else "No Garmin data",
        "class": "stale" if err else "ok",
    })


if __name__ == "__main__":
    main()
